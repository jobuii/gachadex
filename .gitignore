# Windows "mark of the web" alternate-data-stream files (WSL exposes NTFS ADS as these on downloads)
*:Zone.Identifier

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.vercel
.gstack/

# Env / secrets (never commit; see apps/api/.env.example)
.env
.env.*
!.env.example

# Local embedded Postgres (PGlite) data dir (incl. the .pglite-dev demo db + crash artifacts)
.pglite*/
**/.pglite*/

# Turborepo cache
.turbo

# Local design mockups (HTML design source-of-truth, kept out of the repo)
mockups/

# agent tool runtime state (do not commit)
.omc/

# read-only live-DB query helpers (prod access tooling; never commit — see memory: live-db-readonly-access)
apps/api/.ro-*

# design references / mockup screenshots (local only; not part of the repo)
/references/
